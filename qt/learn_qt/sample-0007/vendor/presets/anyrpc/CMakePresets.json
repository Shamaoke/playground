
{
  "version": 10,
  "configurePresets": [
    {
      "name": "default",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../../build/anyrpc",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/../../install",
        "CMAKE_POLICY_VERSION_MINIMUM": "3.10",
        "ANYRPC_LIB_BUILD_SHARED": true,
        "BUILD_EXAMPLES": false,
        "BUILD_TESTS": false,
        "BUILD_WITH_LOG4CPLUS": false,
        "BUILD_PROTOCOL_MESSAGEPACK": false,
        "BUILD_PROTOCOL_XML": true
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "install",
      "configurePreset": "default",
      "targets": ["install"]
    }
  ]
}
