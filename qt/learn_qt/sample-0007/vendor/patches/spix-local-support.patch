+// SPDX-License-Identifier: MIT
+
+#include "KeyEvent.h"
+
+#include <Spix/Scene/Events.h>
+#include <Spix/Scene/Scene.h>
+
+#include <utility>
+
+namespace spix::cmd {
+
+KeyEvent::KeyEvent(ItemPath path, int keyCode, KeyModifier modifiers, Action action)
+  : m_path(std::move(path)), m_keyCode(keyCode), m_modifiers(modifiers), m_action(action)
+{
+}
+
+auto KeyEvent::execute(CommandEnvironment& env) -> void
+{
+  auto item { env.scene().itemAtPath(m_path) };
+  if (!item) {
+    auto name { m_action == Action::Press ? "KeyPress: " : "KeyRelease: " };
+    env.state().reportError(std::string { name } + "Item not found: " + m_path.string());
+    return;
+  }
+
+  if (m_action == Action::Press) {
+    env.scene().events().keyPress(item.get(), m_keyCode, m_modifiers);
+  } else {
+    env.scene().events().keyRelease(item.get(), m_keyCode, m_modifiers);
+  }
+}
+
+} // namespace spix::cmd
