+
+class RecordingEvents : public spix::MockEvents {
+public:
+  std::vector<RecordedEvent> recorded;
+
+  auto mouseDown(spix::Item*, spix::Point position, spix::MouseButton button,
+    spix::KeyModifier modifiers) -> void override
+  {
+    recorded.push_back({Kind::MousePress, position, button, 0, modifiers, std::this_thread::get_id()});
+  }
+
+  auto mouseUp(spix::Item*, spix::Point position, spix::MouseButton button,
+    spix::KeyModifier modifiers) -> void override
+  {
+    recorded.push_back({Kind::MouseRelease, position, button, 0, modifiers, std::this_thread::get_id()});
+  }
+
+  auto keyPress(spix::Item*, int keyCode, spix::KeyModifier modifiers) -> void override
+  {
+    recorded.push_back({Kind::KeyPress, {0.0, 0.0}, spix::MouseButtons::None,
+      keyCode, modifiers, std::this_thread::get_id()});
+  }
+
+  auto keyRelease(spix::Item*, int keyCode, spix::KeyModifier modifiers) -> void override
+  {
+    recorded.push_back({Kind::KeyRelease, {0.0, 0.0}, spix::MouseButtons::None,
+      keyCode, modifiers, std::this_thread::get_id()});
+  }
+};
+
+class RecordingScene : public spix::MockScene {
+public:
+  RecordingEvents recorder;
+
+  auto events() -> spix::Events& override
+  {
+    return recorder;
+  }
+};
+
+class Server : public spix::TestServer {
+protected:
+  auto executeTest() -> void override {}
+};
+
+class InputEventsTest : public ::testing::Test {
+protected:
+  spix::CommandExecuter executor;
+  RecordingScene scene;
+  Server server;
+
+  auto SetUp() -> void override
+  {
+    server.setCommandExecuter(&executor);
+    scene.addItemAtPath(spix::MockItem { spix::Size {100.0, 30.0} }, "window/button");
+  }
+};
+
+TEST_F(InputEventsTest, MousePressAndReleaseAreSeparateQueuedEvents)
+{
+  server.mousePress("window/button");
+  EXPECT_TRUE(scene.recorder.recorded.empty());
+  executor.processCommands(scene);
+  ASSERT_EQ(scene.recorder.recorded.size(), 1u);
+  const auto& press { scene.recorder.recorded.front() };
+  EXPECT_EQ(press.kind, Kind::MousePress);
+  EXPECT_DOUBLE_EQ(press.position.x, 50.0);
+  EXPECT_DOUBLE_EQ(press.position.y, 15.0);
+  EXPECT_EQ(press.button, spix::MouseButtons::Left);
+  EXPECT_EQ(press.modifiers, spix::KeyModifiers::None);
+
+  server.mouseRelease("window/button");
+  executor.processCommands(scene);
+  ASSERT_EQ(scene.recorder.recorded.size(), 2u);
+  const auto& release { scene.recorder.recorded.back() };
+  EXPECT_EQ(release.kind, Kind::MouseRelease);
+  EXPECT_DOUBLE_EQ(release.position.x, 50.0);
+  EXPECT_DOUBLE_EQ(release.position.y, 15.0);
+  EXPECT_EQ(release.button, spix::MouseButtons::Left);
+  EXPECT_EQ(release.modifiers, spix::KeyModifiers::None);
+  EXPECT_FALSE(executor.state().hasErrors());
+}
+
+TEST_F(InputEventsTest, KeyPressAndReleasePreserveCodeAndModifiers)
+{
+  const auto modifiers { spix::KeyModifiers::Control | spix::KeyModifiers::Shift };
+  server.keyPress("window/button", spix::KeyCodes::Char_A, modifiers);
+  EXPECT_TRUE(scene.recorder.recorded.empty());
+  executor.processCommands(scene);
+  ASSERT_EQ(scene.recorder.recorded.size(), 1u);
+  EXPECT_EQ(scene.recorder.recorded.front().kind, Kind::KeyPress);
+  EXPECT_EQ(scene.recorder.recorded.front().keyCode, spix::KeyCodes::Char_A);
+  EXPECT_EQ(scene.recorder.recorded.front().modifiers, modifiers);
+
+  server.keyRelease("window/button", spix::KeyCodes::Char_A, modifiers);
+  executor.processCommands(scene);
+  ASSERT_EQ(scene.recorder.recorded.size(), 2u);
+  EXPECT_EQ(scene.recorder.recorded.back().kind, Kind::KeyRelease);
+  EXPECT_EQ(scene.recorder.recorded.back().keyCode, spix::KeyCodes::Char_A);
+  EXPECT_EQ(scene.recorder.recorded.back().modifiers, modifiers);
+  EXPECT_FALSE(executor.state().hasErrors());
+}
+
+TEST_F(InputEventsTest, MissingItemsReportErrorsWithoutSendingEvents)
+{
+  server.mousePress("window/missing");
+  server.mouseRelease("window/missing");
+  server.keyPress("window/missing", spix::KeyCodes::Space, 0);
+  server.keyRelease("window/missing", spix::KeyCodes::Space, 0);
+  executor.processCommands(scene);
+
+  EXPECT_TRUE(scene.recorder.recorded.empty());
+  const auto errors { executor.state().errors() };
+  ASSERT_EQ(errors.size(), 4u);
+  EXPECT_EQ(errors[0], "MousePress: Item not found: window/missing");
+  EXPECT_EQ(errors[1], "MouseRelease: Item not found: window/missing");
+  EXPECT_EQ(errors[2], "KeyPress: Item not found: window/missing");
+  EXPECT_EQ(errors[3], "KeyRelease: Item not found: window/missing");
+}
+
+TEST_F(InputEventsTest, WorkerThreadOnlyEnqueuesEvents)
+{
+  const auto mainThread { std::this_thread::get_id() };
+  auto worker { std::thread { [this] {
+    server.mousePress("window/button");
+    server.keyPress("window/button", spix::KeyCodes::Space, 0);
+    server.keyRelease("window/button", spix::KeyCodes::Space, 0);
+    server.mouseRelease("window/button");
+  } } };
+  worker.join();
+  EXPECT_TRUE(scene.recorder.recorded.empty());
+
+  executor.processCommands(scene);
+  ASSERT_EQ(scene.recorder.recorded.size(), 4u);
+  EXPECT_EQ(scene.recorder.recorded[0].kind, Kind::MousePress);
+  EXPECT_EQ(scene.recorder.recorded[1].kind, Kind::KeyPress);
+  EXPECT_EQ(scene.recorder.recorded[2].kind, Kind::KeyRelease);
+  EXPECT_EQ(scene.recorder.recorded[3].kind, Kind::MouseRelease);
+  for (const auto& event : scene.recorder.recorded) {
+    EXPECT_EQ(event.thread, mainThread);
+  }
+}
+
+TEST_F(InputEventsTest, ExistingClickAndEnterKeyStillSendBothEvents)
+{
+  server.mouseClick("window/button");
+  server.enterKey("window/button", spix::KeyCodes::Space, spix::KeyModifiers::None);
+  executor.processCommands(scene);
+
+  ASSERT_EQ(scene.recorder.recorded.size(), 4u);
+  EXPECT_EQ(scene.recorder.recorded[0].kind, Kind::MousePress);
+  EXPECT_EQ(scene.recorder.recorded[1].kind, Kind::MouseRelease);
+  EXPECT_EQ(scene.recorder.recorded[2].kind, Kind::KeyPress);
+  EXPECT_EQ(scene.recorder.recorded[3].kind, Kind::KeyRelease);
+  EXPECT_EQ(scene.recorder.recorded[2].keyCode, spix::KeyCodes::Space);
+  EXPECT_FALSE(executor.state().hasErrors());
+}
