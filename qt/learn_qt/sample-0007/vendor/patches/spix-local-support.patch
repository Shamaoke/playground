@@ -0,0 +1,35 @@
+// SPDX-License-Identifier: MIT
+
+#include "MouseButtonEvent.h"
+
+#include <Spix/Scene/Events.h>
+#include <Spix/Scene/Scene.h>
+
+#include <utility>
+
+namespace spix::cmd {
+
+MouseButtonEvent::MouseButtonEvent(ItemPath path, Action action)
+  : m_path(std::move(path)), m_action(action)
+{
+}
+
+auto MouseButtonEvent::execute(CommandEnvironment& env) -> void
+{
+  auto item { env.scene().itemAtPath(m_path) };
+  if (!item) {
+    auto name { m_action == Action::Press ? "MousePress: " : "MouseRelease: " };
+    env.state().reportError(std::string { name } + "Item not found: " + m_path.string());
+    return;
+  }
+
+  auto size { item->size() };
+  auto position { Point { size.width / 2.0, size.height / 2.0 } };
+  if (m_action == Action::Press) {
+    env.scene().events().mouseDown(item.get(), position, MouseButtons::Left, KeyModifiers::None);
+  } else {
+    env.scene().events().mouseUp(item.get(), position, MouseButtons::Left, KeyModifiers::None);
+  }
+}
+
+} // namespace spix::cmd
