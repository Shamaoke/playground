+// Prefer floating-point drag positions when supported by the Qt headers.
+// Older Qt releases need integer positions; preserve the previous truncation.
+template <typename Event>
+auto dragEventPosition(const QPointF& position)
+{
+  if constexpr (std::is_constructible_v<
+    Event, QPointF, Qt::DropActions, const QMimeData*, Qt::MouseButtons, Qt::KeyboardModifiers>) {
+    return position;
+  } else {
+    return QPoint(static_cast<int>(position.x()), static_cast<int>(position.y()));
+  }
+}
+
+auto globalPositionForWindow(QQuickWindow* window, const QPointF& position) -> QPointF
+{
+#if (QT_VERSION >= QT_VERSION_CHECK(6, 0, 0))
+  return window->mapToGlobal(position);
+#else
+  // Qt 5 maps integer positions only. Keep the fractional event coordinates.
+  return QPointF(window->mapToGlobal(QPoint())) + position;
+#endif
+}
